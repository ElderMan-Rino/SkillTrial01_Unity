.asset-load-test-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(20, 20, 20);
    padding: 12px;
}

.button-row {
    flex-direction: row;
    margin-bottom: 8px;
}

.test-button {
    margin-right: 10px;
    padding: 20px 32px;
    font-size: 32px;
    min-width: 220px;
    min-height: 72px;
    background-color: rgb(70, 70, 70);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(110, 110, 110);
    border-right-color: rgb(110, 110, 110);
    border-top-color: rgb(110, 110, 110);
    border-bottom-color: rgb(110, 110, 110);
    color: rgb(230, 230, 230);
}

.test-button:hover {
    background-color: rgb(90, 90, 90);
}

.log-scroll-view {
    flex-grow: 1;
    border-width: 1px;
    border-color: rgb(60, 60, 60);
}

.log-scroll-view > .unity-scroll-view__content-and-vertical-scroll-container {
    background-color: rgb(10, 10, 10);
}

.log-container {
    padding: 4px;
}

.log-line {
    font-size: 32px;
    white-space: normal;
    margin-bottom: 4px;
}

.log-line-debug {
    color: rgb(150, 150, 150);
}

.log-line-info {
    color: rgb(220, 220, 220);
}

.log-line-warning {
    color: rgb(230, 200, 60);
}

.log-line-error {
    color: rgb(230, 80, 80);
}
